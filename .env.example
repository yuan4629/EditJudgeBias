# Environment variables for the paid steps (quality validation and judge runs).
# Every other step is local and needs neither.
#
# The code reads these from the process environment only; it never reads this
# file. Export them in your shell, e.g. `set -a; source .env; set +a` after copying
# this file to `.env` (which is git-ignored).
#
# Any OpenAI-compatible `/chat/completions` endpoint works: the OpenAI API itself,
# or a gateway that serves several vendors' models under one key. The model ids
# each judge sends are set in `configs/judge/*.yaml` (`api_model`).
EDITJUDGE_API_KEY=
EDITJUDGE_BASE_URL=https://api.openai.com/v1/
