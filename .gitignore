# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Credentials: keys are read from the environment only (see .env.example)
.env
.env.*
!.env.example

# Upstream corpora (third-party; obtain them from their owners, see docs/DATASETS.md)
tmp_data/

# Everything the pipeline builds or collects. Only provenance metadata is tracked.
data/*
!data/provenance/
data/provenance/.sha1_cache.json
results/

# Editor / OS noise and stray backups
.idea/
.vscode/
.DS_Store
Thumbs.db
*.bak
*.orig
*.rej
*.swp
